# 이 파일을 .env 로 복사해서 쓰세요:  cp .env.example .env
# .env 는 커밋되지 않습니다. 새 변수를 추가하면 이 파일에도 꼭 같이 추가하세요.
# 팀 공통 환경: Python 3.12 / LLM qwen3:8b / 임베딩 KURE-v3 (로컬 폴더)
#   준비:  ollama pull qwen3:8b

# ── LLM (Ollama, OpenAI 호환 API) ────────────────────────────
# openai: OpenAI 호환 API(Ollama 등) / local_math: LLM 없이 사칙연산 데모 (Ollama 없을 때 시연용)
LLM_PROVIDER=openai
# 로컬 Ollama 기본 주소. 공용 서버로 바꿀 때는 이 값만 바꾸면 됩니다.
LLM_BASE_URL=http://localhost:11434/v1
# 팀 전체가 같은 모델/태그를 써야 결과가 맞습니다. 바꿀 땐 팀에 공유하세요.
# 기본은 컨텍스트를 24,576 토큰으로 늘린 qwen3:8b-24k (만드는 법: config/ollama/README.md).
# 비워 두면 qwen3:8b-24k 를 쓰고, 아직 안 만들었으면 qwen3:8b(한도 4,096) 로 대신합니다.
LLM_MODEL=qwen3:8b-24k
# Ollama는 키를 검사하지 않지만 OpenAI 클라이언트가 값을 요구해서 아무 값이나 둡니다.
LLM_API_KEY=ollama
# 응답 1회 대기 시간(초). 긴 문서(약 1만 5천 토큰)를 처음 읽을 때 약 2분 걸립니다
LLM_TIMEOUT_SECONDS=300
# 모델 컨텍스트 한도(토큰). 비우면 Ollama 에 물어봅니다. Ollama 가 아닌 서버를 쓸 때만 정합니다
LLM_CONTEXT_TOKENS=

# 에이전트 초안 생성만 쓰는 더 큰 모델. 초안은 가끔 만들어서 느려도 정확한 쪽을 쓴다.
# 서버에 이 모델이 없으면(ollama pull 안 함) 위 LLM_MODEL 로 대신 만든다. 비우면 LLM_MODEL 을 쓴다.
# 16GB 맥 기준 qwen3:14b (약 9.3GB) 가 한계. 은행 서버에서는 더 큰 모델로 바꾼다.
DRAFT_LLM_MODEL=qwen3:14b
# 초안 응답 대기 시간(초). 14b 는 첫 호출에 모델을 싣느라 오래 걸릴 수 있다
DRAFT_LLM_TIMEOUT_SECONDS=300
# 초안 모델을 다른 서버에서 돌릴 때만 (비우면 LLM_BASE_URL, LLM_API_KEY)
DRAFT_LLM_BASE_URL=
DRAFT_LLM_API_KEY=

# ── 임베딩 (문서 검색) ──────────────────────────────────────
# KURE-v3 로컬 폴더 (폐쇄망: 인터넷에서 받지 않음, git 에 없음). 2048차원 → DB chunk.embedding halfvec(2048)
EMBEDDING_MODEL_PATH=
# 청크 길이를 셀 토크나이저. 비우면 EMBEDDING_MODEL_PATH/tokenizer.json
CHUNKER_TOKENIZER_PATH=

# ── DB (PostgreSQL 16 + pgvector 0.8 이상) ──────────────────
# 형식: postgresql+asyncpg://계정:비밀번호@주소:5432/agent_platform   (실제 값은 .env 에만)
DATABASE_URL=
# 등록한 문서 원본 저장 폴더. 비우면 data/storage
STORAGE_ROOT=

# ── 로그인 (마이그레이션 0007) ───────────────────────────────
# dev     = 로그인 없이 화면 왼쪽 아래에서 개발용 사용자 선택 (X-User-Id 헤더, config/dev_users.yaml)
# session = 로그인 화면. 계정은 DB users 표, 비밀번호는 scripts/db/set_password.py 로 정한다 (DATABASE_URL 필요)
AUTH_MODE=dev
# 로그인 유지 시간(시간), 연속 실패 몇 번에 몇 분 잠글지
AUTH_SESSION_HOURS=12
AUTH_MAX_FAILS=5
AUTH_LOCK_MINUTES=10
# HTTPS 로 서비스할 때만 true (http://localhost 개발·시연은 false)
AUTH_COOKIE_SECURE=false

# ── 저장 위치 (마이그레이션 0008·0013) ───────────────────────
# memory = 서버 메모리·로컬 SQLite (테스트·DB 없을 때)
# db = 팀 DB (에이전트·공유 요청·대화 기록, 알림함·문서·고객 안내 발송 기록). 문서 파일은 STORAGE_ROOT/outputs/ 아래
# db 로 쓸 때 화면에서 쓰는 사람은 DB users 표에 있어야 한다 (scripts/db/seed_users.py)
STORE=memory

# ── 하네스 (에이전트 루프) ───────────────────────────────────
# 한 요청에서 LLM ↔ 툴 왕복 최대 횟수 (무한 루프 방지)
HARNESS_MAX_TURNS=10
# 툴 1회 실행 제한 시간(초)
HARNESS_TOOL_TIMEOUT_SECONDS=30
# 플래너 하네스: 1 이면 계획 → 단계마다 툴 하나씩 실행 (harness/plan_runner.py), 0 이면 예전 루프
HARNESS_PLANNER=1

# ── 권한 ────────────────────────────────────────────────────
# 정책 규칙 파일 경로 (형식은 권한 담당이 정의)
PERMISSION_POLICY_PATH=config/permissions.yaml
# 정책에 맞는 규칙이 없을 때 결정: allow | deny | ask
PERMISSION_DEFAULT_DECISION=ask
# 권한 판정 감사 로그 파일 경로
PERMISSION_AUDIT_LOG_PATH=logs/permission_audit.jsonl
# 답 검사(조회 결과에 없는 숫자·근거, 실행하지 않은 완료 주장)에 걸린 답 기록. 관리자만 본다 (harness/answer_check.py)
ANSWER_CHECK_LOG_PATH=logs/answer_checks.jsonl
# ASK 승인 요청에 응답이 없으면 거절로 처리할 때까지의 시간(초). 값은 팀 미결 (SYS-16)
PERMISSION_APPROVAL_TIMEOUT_SECONDS=120

# ── 툴 ──────────────────────────────────────────────────
# 문서 검색 툴이 읽는 문서 조각 파일 (벡터 DB 연결 전 임시)
DOC_CHUNKS_PATH=data/fixtures/doc_chunks.json
# 문서 검색·원문 열람 툴이 읽는 곳: file = 아래 예시 파일, db = 팀 DB(pgvector, DATABASE_URL·EMBEDDING_MODEL_PATH 필요)
DOC_STORE=file
# 규정 안내의 검색 점수 하한 (0~1). 0 = 거르지 않음 (11/24 측정: 0.30 은 바꿔 말한 질문의 정답까지 버렸다).
# 문서가 늘어 엉뚱한 후보가 많아지면 올려서 다시 측정한다.
DOC_EVIDENCE_MIN_SCORE=0
# 업로드 문서 읽기 툴(parse_doc): 업로드 폴더, 이 툴만의 제한시간(초), 파서 모델 폴더(PDF·이미지용, git 에 없음)
UPLOAD_DIR=data/uploads
PARSE_TOOL_TIMEOUT_SECONDS=600
PARSER_MODELS_DIR=

# Gmail MCP는 별도 프로세스(기본 8001)로 실행한다. 아래 기본 주소로 메일 도구를 등록한다.
# 명시적으로 빈 값으로 설정하면 메일 도구 등록을 끈다.
GMAIL_MCP_URL=http://127.0.0.1:8001/mcp
# 개발용: 플랫폼 user_id와 Gmail 연결 사번이 다를 때만 명시적으로 매핑한다.
# 로그인 연동 후에는 build_from_env(gmail_account_resolver=...)로 사용자별 연결을 조회한다.
# 이메일 주소를 requester_id로 사용하지 않는다. Gmail 주소 저장과 OAuth 발송 권한 연결은 별개다.
GMAIL_MCP_USER_MAP={}
# 설정하면 FastAPI와 MCP 서버 양쪽에 같은 토큰을 넣는다. 실제 값은 커밋하지 않는다.
GMAIL_MCP_TOKEN=
# ── 예약 실행 (config/schedules.yaml) ──────────────────────
# true 면 평일 09:10 시장 데이터 수집(UC-02-1), 09:20 금리·환율 리포트(UC-02), 09:30 만기 알림(UC-03)을 돌린다.
# false 여도 관리자는 화면 "예약 작업" 에서 지금 실행할 수 있다.
# 시장 데이터 수집(UC-02-1)은 시장 MCP 가 한다 (ECOS 인증키·시장 DB 연결은 mcp-servers/market/.env 에만).
SCHEDULER_ENABLED=false

# 시장 MCP (별도 프로세스 8002). ECOS 인증키는 여기에 넣지 않고 MCP 전용 환경에만 설정한다.
MARKET_MCP_URL=http://127.0.0.1:8002/mcp
MARKET_MCP_TOKEN=
# 메일을 플랫폼 PostgreSQL 에 저장하려면 (alembic upgrade head 후). 비우면 개발용 SQLite(data/db/mail.sqlite3).
# requester_id 는 users.login_id 여야 한다. 실제 값은 커밋하지 않는다.
GMAIL_DATABASE_URL=
# 영업일 계산에서 뺄 휴일 (테스트용)
BUSINESS_HOLIDAYS_PATH=data/fixtures/business_holidays_demo.json
# 가상 심사시스템: 심사 건 목록과 등록 요청 저장 파일 (SQLite, git 에 안 올라감)
REVIEW_CASES_PATH=data/fixtures/review_cases.json
REVIEW_REQUEST_DB_PATH=data/review_requests.sqlite3

# ── API (개발용) ────────────────────────────────────────────
# 로그인(COM-01) 전까지 X-User-Id 헤더로 고르는 개발용 사용자 목록
DEV_USERS_PATH=config/dev_users.yaml
# 관리자가 미리 만든 에이전트 템플릿 (시나리오 템플릿 화면)
AGENT_TEMPLATES_PATH=config/agent_templates.yaml
