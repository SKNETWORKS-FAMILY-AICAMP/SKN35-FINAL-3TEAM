        }
      ],
      "expected": {
        "stop_reason": "denied",
        "llm_calls": 1,
        "executed": [],
        "tool_messages": [
          {
            "call_id": "c1",
            "contains": "scripted deny"
          }
        ],
        "audit": [
          {
            "call_id": "c1",
            "decision": "deny",
            "approval": null,
            "executed": false,
            "tool_ok": null
          }
        ],
        "approval_requests": [],
        "final_contains": "scripted deny",
        "denial": {
          "kind": "deny",
          "tool_name": "delete_file"
        },
        "wrapup_call": false
      }
    },
