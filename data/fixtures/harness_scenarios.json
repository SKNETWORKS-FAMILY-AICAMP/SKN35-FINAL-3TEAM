{
  "_doc": {
    "설명": "하네스 공통 시나리오. LLM 은 llm_script 순서대로 응답하는 가짜(ScriptedLLM)라서 결과가 항상 같다.",
    "llm_script": "chat() 이 호출될 때마다 하나씩 돌려줄 assistant 응답. content 또는 tool_calls.",
    "tools": "등록할 가짜 툴. output 을 돌려주거나, raises 가 있으면 그 메시지로 예외를 던진다.",
    "permissions": "툴 이름 → allow|deny|ask. 없으면 allow. 사유는 'scripted <decision>' 으로 고정.",
    "approval": "ASK 일 때 가짜 승인자가 돌려줄 ApprovalOutcome: approved | rejected | timeout.",
    "expected.executed": "Tool.run() 이 호출된 툴 이름 순서. 생략하면 검사 안 함.",
    "expected.tool_messages": "LLM 에게 돌려준 role=tool 메시지 검사. contains 는 content 에 포함돼야 할 문자열.",
    "expected.audit": "AuditLogger 에 남아야 할 기록 (call_id 순서대로). approval 은 AuditRecord.approval, tool_ok 는 실행했을 때 툴 성공 여부. 생략하면 검사 안 함.",
    "expected.approval_requests": "ApprovalHandler 가 받은 call_id 목록.",
    "expected.final_contains": "final_message.content 에 포함돼야 할 문자열 (final_content 대신, 고정 문구라 구현마다 다를 때).",
    "expected.denial": "RunResult.denial 의 kind (deny | rejected | timeout) / tool_name.",
    "expected.wrapup_call": "true 면 마지막 chat() 이 tools=[] 로 불린 마무리 호출이어야 하고, false 면 그런 호출이 없어야 한다.",
    "llm_script.raises": "그 차례의 chat() 이 이 메시지로 예외를 던진다."
  },
  "scenarios": [
    {
      "id": "direct_answer",
      "description": "툴 없이 바로 답한다",
      "user_input": "안녕?",
      "max_turns": 5,
      "tools": [
        {
          "name": "search",
          "output": "검색 결과"
        }
      ],
      "llm_script": [
        {
          "content": "안녕하세요!"
        }
      ],
      "expected": {
        "stop_reason": "completed",
        "final_content": "안녕하세요!",
        "llm_calls": 1,
        "executed": [],
        "tool_messages": [],
        "audit": [],
        "approval_requests": []
      }
    },
    {
      "id": "single_tool",
      "description": "툴 1번 호출 후 결과를 보고 답한다",
      "user_input": "SK 뉴스 찾아줘",
      "max_turns": 5,
      "tools": [
        {
          "name": "search",
          "output": "SK 관련 뉴스 3건"
        }
      ],
      "llm_script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "search",
              "arguments": {
                "q": "SK 뉴스"
              }
            }
          ]
        },
        {
          "content": "뉴스 3건을 찾았어요."
        }
      ],
      "expected": {
        "stop_reason": "completed",
        "final_content": "뉴스 3건을 찾았어요.",
        "llm_calls": 2,
        "executed": [
          "search"
        ],
        "tool_messages": [
          {
            "call_id": "c1",
            "contains": "SK 관련 뉴스 3건"
          }
        ],
        "audit": [
          {
            "call_id": "c1",
            "decision": "allow",
            "approval": null,
            "executed": true,
            "tool_ok": true
          }
        ],
        "approval_requests": []
      }
    },
    {
      "id": "parallel_tools",
      "description": "한 응답에 툴 호출 2개",
      "user_input": "날씨랑 뉴스 둘 다",
      "max_turns": 5,
      "tools": [
        {
          "name": "weather",
          "output": "맑음"
        },
        {
          "name": "search",
          "output": "뉴스 1건"
        }
      ],
      "llm_script": [
        {
          "tool_calls": [
            {
              "id": "c1",
              "name": "weather",
              "arguments": {
                "city": "서울"
              }
            },
            {
              "id": "c2",
              "name": "search",
              "arguments": {
                "q": "뉴스"
              }
            }
          ]
        },
        {
          "content": "서울은 맑고 뉴스는 1건이에요."
        }
      ],
      "expected": {
        "stop_reason": "completed",
        "final_content": "서울은 맑고 뉴스는 1건이에요.",
        "llm_calls": 2,
        "executed": [
          "weather",
          "search"
        ],
        "tool_messages": [
          {
            "call_id": "c1",
            "contains": "맑음"
          },
          {
            "call_id": "c2",
            "contains": "뉴스 1건"
          }
        ],
        "audit": [
          {
            "call_id": "c1",
            "decision": "allow",
            "approval": null,
            "executed": true,
            "tool_ok": true
          },
          {
            "call_id": "c2",
            "decision": "allow",
            "approval": null,
            "executed": true,
            "tool_ok": true
          }
        ],
        "approval_requests": []
      }
    },
    {
      "id": "denied",
      "description": "DENY 면 즉시 멈춘다. 성공한 툴이 없으니 LLM 을 다시 부르지 않고 고정 문구(사유 포함)로 답한다",
      "user_input": "파일 지워줘",
      "max_turns": 5,
      "tools": [
        {
          "name": "delete_file",
          "output": "삭제됨"
