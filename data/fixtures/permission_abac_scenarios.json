{
  "_doc": {
    "설명": "ABAC 권한 체커 공통 시나리오. 규칙 형식은 contracts.permission.PolicyRule / Condition.",
    "rules": "위에서부터 처음 맞는 규칙이 이긴다. conditions 는 모두(AND) 참이어야 맞는다.",
    "cases": "tool + roles + attributes + args 로 check() 했을 때 나와야 할 decision 과 rule_id (null 이면 기본값).",
    "op_cases": "연산자 하나씩 검사. principal.attributes.x 에 attr_value 를 넣고 조건 {attr: principal.x, op, value} 하나짜리 allow 규칙(기본 deny)으로 판정. matches=true 면 allow."
  },
  "rules": [
    {"id": "admin-all", "tool": "*", "decision": "allow", "roles": ["admin"]},
    {"id": "intern-block", "tool": "*", "decision": "deny", "reason": "인턴은 툴을 쓸 수 없음",
     "conditions": [{"attr": "principal.position", "op": "in", "value": ["인턴"]}]},
    {"id": "secret-docs", "tool": "search_documents", "decision": "deny", "reason": "보안등급이 부족함",
     "conditions": [{"attr": "args.security_level", "op": "gt", "value_from": "principal.security_level"}]},
    {"id": "search-ok", "tool": "search_documents", "decision": "allow"},
    {"id": "db-own-dept", "tool": "query_db", "decision": "allow",
     "conditions": [{"attr": "args.department_id", "op": "eq", "value_from": "principal.department_id"}]},
    {"id": "db-others", "tool": "query_db", "decision": "deny", "reason": "다른 부서 데이터는 조회할 수 없음"},
    {"id": "email-internal", "tool": "send_email", "decision": "allow",
     "conditions": [{"attr": "args.to", "op": "contains", "value": "@corp.example"}]},
    {"id": "email-external", "tool": "send_email", "decision": "ask", "reason": "외부로 메일이 나갑니다"},
    {"id": "delete-senior", "tool": "delete_file", "decision": "allow",
     "conditions": [
       {"attr": "principal.security_level", "op": "gte", "value": 3},
       {"attr": "principal.position", "op": "in", "value": ["팀장", "부장"]}
     ]},
    {"id": "delete-others", "tool": "delete_file", "decision": "deny", "reason": "보안등급 3 이상 팀장·부장만 삭제 가능"},
    {"id": "edit-own-team", "tool": "update_user", "decision": "allow", "roles": ["dept_head"],
     "conditions": [{"attr": "args.user.department_id", "op": "eq", "value_from": "principal.department_id"}]}
  ],
  "default": "ask",
  "cases": [
    {"id": "admin_overrides_all", "tool": "delete_file", "roles": ["admin"], "attributes": {"position": "인턴"}, "args": {},
     "decision": "allow", "rule_id": "admin-all"},
    {"id": "intern_blocked", "tool": "search_documents", "roles": ["member"], "attributes": {"position": "인턴", "security_level": 5}, "args": {"security_level": 1},
     "decision": "deny", "rule_id": "intern-block"},
    {"id": "doc_level_too_high", "tool": "search_documents", "roles": ["member"], "attributes": {"security_level": 2}, "args": {"security_level": 3},
     "decision": "deny", "rule_id": "secret-docs"},
    {"id": "doc_level_equal", "tool": "search_documents", "roles": ["member"], "attributes": {"security_level": 3}, "args": {"security_level": 3},
     "decision": "allow", "rule_id": "search-ok"},
    {"id": "doc_arg_missing_condition_false", "tool": "search_documents", "roles": ["member"], "attributes": {"security_level": 1}, "args": {},
     "decision": "allow", "rule_id": "search-ok"},
    {"id": "db_own_department", "tool": "query_db", "roles": ["member"], "attributes": {"department_id": 10}, "args": {"department_id": 10},
     "decision": "allow", "rule_id": "db-own-dept"},
    {"id": "db_other_department", "tool": "query_db", "roles": ["member"], "attributes": {"department_id": 10}, "args": {"department_id": 20},
     "decision": "deny", "rule_id": "db-others"},
    {"id": "db_principal_attr_missing", "tool": "query_db", "roles": ["member"], "attributes": {}, "args": {"department_id": 10},
     "decision": "deny", "rule_id": "db-others"},
    {"id": "email_internal", "tool": "send_email", "roles": ["member"], "attributes": {}, "args": {"to": "kim@corp.example"},
     "decision": "allow", "rule_id": "email-internal"},
    {"id": "email_external", "tool": "send_email", "roles": ["member"], "attributes": {}, "args": {"to": "kim@gmail.com"},
     "decision": "ask", "rule_id": "email-external"},
    {"id": "delete_all_conditions_met", "tool": "delete_file", "roles": ["member"], "attributes": {"security_level": 3, "position": "팀장"}, "args": {},
     "decision": "allow", "rule_id": "delete-senior"},
    {"id": "delete_one_condition_fails", "tool": "delete_file", "roles": ["member"], "attributes": {"security_level": 3, "position": "사원"}, "args": {},
     "decision": "deny", "rule_id": "delete-others"},
    {"id": "nested_args_match", "tool": "update_user", "roles": ["dept_head"], "attributes": {"department_id": 10}, "args": {"user": {"department_id": 10}},
     "decision": "allow", "rule_id": "edit-own-team"},
    {"id": "nested_args_role_mismatch", "tool": "update_user", "roles": ["member"], "attributes": {"department_id": 10}, "args": {"user": {"department_id": 10}},
     "decision": "ask", "rule_id": null},
    {"id": "no_match_default", "tool": "weather", "roles": ["member"], "attributes": {}, "args": {},
     "decision": "ask", "rule_id": null}
  ],
  "op_cases": [
    {"id": "eq_true", "attr_value": 3, "op": "eq", "value": 3, "matches": true},
    {"id": "eq_false", "attr_value": 3, "op": "eq", "value": 4, "matches": false},
    {"id": "ne_true", "attr_value": 3, "op": "ne", "value": 4, "matches": true},
    {"id": "gt_true", "attr_value": 4, "op": "gt", "value": 3, "matches": true},
    {"id": "gt_equal_false", "attr_value": 3, "op": "gt", "value": 3, "matches": false},
    {"id": "gte_equal_true", "attr_value": 3, "op": "gte", "value": 3, "matches": true},
    {"id": "lt_true", "attr_value": 2, "op": "lt", "value": 3, "matches": true},
    {"id": "lte_false", "attr_value": 4, "op": "lte", "value": 3, "matches": false},
    {"id": "in_true", "attr_value": "팀장", "op": "in", "value": ["팀장", "부장"], "matches": true},
    {"id": "not_in_true", "attr_value": "사원", "op": "not_in", "value": ["팀장", "부장"], "matches": true},
    {"id": "contains_list_true", "attr_value": ["a", "b"], "op": "contains", "value": "b", "matches": true},
    {"id": "contains_str_false", "attr_value": "hello", "op": "contains", "value": "xyz", "matches": false},
    {"id": "gt_type_mismatch_false", "attr_value": "3", "op": "gt", "value": 2, "matches": false},
    {"id": "missing_attr_false", "attr_value": null, "op": "ne", "value": 1, "matches": false}
  ]
}
