# 앱(FastAPI)을 서버 서비스로 등록하는 예시. 경로·계정은 서버에 맞게 바꾼다.
#   sudo cp deploy/linux/agent-platform.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now agent-platform
[Unit]
Description=Agent Platform API (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=agent
WorkingDirectory=/opt/agent-platform
EnvironmentFile=/opt/agent-platform/.env
Environment=PYTHONUTF8=1
ExecStart=/opt/agent-platform/.venv/bin/python -m uvicorn main:app --app-dir apps/api/src --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
