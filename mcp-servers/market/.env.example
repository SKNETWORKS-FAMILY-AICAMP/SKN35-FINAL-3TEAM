# MCP 서버 전용 설정. 실제 .env는 커밋하지 않는다.
# 리포트(market_snapshot)가 값을 읽는 곳
#   db: 시장 DB (UC-02-1 수집·검사를 통과한 값만, 추천). live: ECOS 직접 조회. replay: 기록 파일 재생(실시간 아님)
MARKET_DATA_MODE=db
# 한국은행 ECOS 인증키 (https://ecos.bok.or.kr/api/ 에서 무료 발급). 이 파일에만 둔다 (플랫폼 .env·프롬프트에 넣지 않음)
ECOS_API_KEY=
# 시장 DB (MARKET_DATA_MODE=db, 수집기). 플랫폼 .env 의 DATABASE_URL 과 같은 DB
DATABASE_URL=
# 수집기(UC-02-1)가 받아 올 곳: live = ECOS, replay = 기록 파일. 비우면 인증키가 있으면 live, 없으면 replay
MARKET_COLLECT_MODE=
# 수집기가 받은 파일을 놓는 받은 편지함 폴더 (경계). 적재기는 여기 파일만 검사해 넣는다
MARKET_INBOX_DIR=data/market_inbox
MARKET_MCP_HOST=127.0.0.1
MARKET_MCP_PORT=8002
# 플랫폼 .env의 MARKET_MCP_TOKEN과 같은 값. 실제 토큰은 커밋하지 않는다.
MARKET_MCP_TOKEN=
# 비우면 함께 제공한 기록 파일. replay 모드에서만 사용한다.
MARKET_REPLAY_FILE=
# 양식 파일을 바꾸면 다음 검색부터 반영된다. DB/RAG 검색 어댑터 연결 전 로컬 테스트용.
REPORT_TEMPLATES_DIR=config/report_templates
REPORT_DEFAULT_TEMPLATE=market-daily
