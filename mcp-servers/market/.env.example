# MCP 서버 전용 설정. 실제 .env는 커밋하지 않는다.
# live: ECOS 직접 조회. replay: 전달 ZIP의 기록 파일 재생(실시간 아님).
MARKET_DATA_MODE=live
ECOS_API_KEY=
MARKET_MCP_HOST=127.0.0.1
MARKET_MCP_PORT=8002
# 플랫폼 .env의 MARKET_MCP_TOKEN과 같은 값. 실제 토큰은 커밋하지 않는다.
MARKET_MCP_TOKEN=
# 비우면 함께 제공한 기록 파일. replay 모드에서만 사용한다.
MARKET_REPLAY_FILE=
# 양식 파일을 바꾸면 다음 검색부터 반영된다. DB/RAG 검색 어댑터 연결 전 로컬 테스트용.
REPORT_TEMPLATES_DIR=config/report_templates
REPORT_DEFAULT_TEMPLATE=market-daily
